{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name" : "oftalmed/cta",
    "title" : "Блок CTA",
    "description": "Блок призыва к действию с ссылками на мессенджеры",
    "acf": {
        "mode": "preview",
        "renderTemplate": "cta.php"
    },
    "supports": {
        "align": ["full", "wide"],
        "anchor": true
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        }
    } 
}